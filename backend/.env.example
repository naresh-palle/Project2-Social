# CR8 Studio — environment template
# Copy to backend/.env (or repo root .env) and fill in values.

# --- Core ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=cr8
JWT_SECRET=change-me
CORS_ORIGINS=*

# --- LLM (optional; AI help / bio / captions) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# EMERGENT_LLM_KEY=

# --- Apify social scraper ---
# Required for Profile Edit auto-fill and creator sync-analytics.
APIFY_TOKEN=
# Optional actor overrides (discovery refresh uses the same ApifyProvider)
# APIFY_ACTOR_INSTAGRAM=apify~instagram-scraper
# Optional actor overrides (Apify actor IDs use ~ instead of /)
# APIFY_ACTOR_INSTAGRAM=apify~instagram-scraper
# APIFY_ACTOR_YOUTUBE=streamers~youtube-channel-scraper
# APIFY_ACTOR_FACEBOOK=apify~facebook-pages-scraper

# --- Google Sign-In (must match frontend REACT_APP_GOOGLE_CLIENT_ID) ---
# GOOGLE_CLIENT_ID=858111971322-uf792cb63b4u97u1fu494kngaajuaibr.apps.googleusercontent.com
# Authorized JavaScript origins must include:
#   http://localhost:3000
#   https://project2-social.onrender.com
#   https://naresh-palle.github.io
#   https://flugr.in
# See docs/google-oauth-setup.md
GOOGLE_CLIENT_ID=
# Required for Google authorization-code redirect flow (GIS ID-token login works without it)
GOOGLE_CLIENT_SECRET=

# --- Facebook Login (Meta) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# META_APP_ID=   # alias
# META_APP_SECRET=

# --- Instagram Business Login (NOT Facebook Login) ---
# Uses instagram.com/oauth + instagram_business_basic.
# Professional Instagram accounts required; App Review may be pending.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Public URLs used to build OAuth redirect URIs
FRONTEND_URL=https://flugr.in
API_PUBLIC_URL=https://project2-social.onrender.com
# Optional per-provider redirect overrides:
# GOOGLE_REDIRECT_URI=
# FACEBOOK_REDIRECT_URI=
# INSTAGRAM_REDIRECT_URI=

# Encrypt stored social access tokens at rest
OAUTH_ENCRYPTION_KEY=
